pipeline {
    agent any

    stages {
        stage('Получение исходного кода') {
            steps {
                checkout scm
            }
        }

        stage('Проверка инструментов') {
            steps {
                bat 'python --version'
                bat 'node --version'
                bat 'npm.cmd --version'
                bat 'docker --version'
                bat 'docker compose version'
            }
        }

        stage('Установка зависимостей') {
            steps {
                bat 'python -m venv .venv'
                bat '.venv\\Scripts\\python.exe -m pip install --upgrade pip'
                bat '.venv\\Scripts\\python.exe -m pip install -r requirements.txt'
            }
        }

        stage('Миграции базы данных для тестов') {
            steps {
                bat '.venv\\Scripts\\python.exe manage.py migrate --noinput'
            }
        }

        stage('Запуск тестов') {
            steps {
                bat '.venv\\Scripts\\python.exe -m pytest'
            }
        }

        stage('Проверка конфигурации Docker') {
            steps {
                bat 'docker compose -p devops config -q'
            }
        }

        stage('Сборка Docker-образов') {
            steps {
                bat 'docker compose -p devops build'
            }
        }

        stage('Деплой приложения') {
            when {
                expression {
                    env.BRANCH_NAME == 'main' ||
                    env.GIT_BRANCH == 'origin/main' ||
                    env.GIT_BRANCH == 'refs/remotes/origin/main' ||
                    env.BRANCH == 'refs/heads/main'
                }
            }

            steps {
                bat 'docker compose -p devops up -d'
            }
        }

        stage('Проверка запущенных контейнеров') {
            when {
                expression {
                    env.BRANCH_NAME == 'main' ||
                    env.GIT_BRANCH == 'origin/main' ||
                    env.GIT_BRANCH == 'refs/remotes/origin/main' ||
                    env.BRANCH == 'refs/heads/main'
                }
            }

            steps {
                bat 'docker compose -p devops ps'
            }
        }
    }
}