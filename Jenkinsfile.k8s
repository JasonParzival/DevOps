// ЛР3: независимая Jenkins Job под Windows + Docker Desktop Kubernetes.
// У старых Job остаются Jenkinsfile / Jenkinsfile.docker и их прежние настройки.
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    stages {
        stage('Получение кода из GitHub') {
            steps {
                checkout scm
            }
        }

        stage('Проверка Docker и Kubernetes') {
            steps {
                bat 'docker --version'
                bat 'docker compose version'
                bat 'docker info --format "{{.OSType}}"'
                bat 'kubectl version --client'
                bat 'python --version'
                // Только проверка. Не создаём секреты и не трогаем базу данных.
                bat 'python lab3\\k8s\\ci_deploy.py --check-only'
            }
        }

        stage('Сборка backend-образов') {
            steps {
                bat 'docker build -t lab3-users:k8s-j%BUILD_NUMBER% lab3\\services\\users'
                bat 'docker build -t lab3-catalog:k8s-j%BUILD_NUMBER% lab3\\services\\catalog'
                bat 'docker build -t lab3-orders:k8s-j%BUILD_NUMBER% lab3\\services\\orders'
            }
        }

        stage('Тесты users на отдельной PostgreSQL') {
            steps {
                bat 'docker compose -p lab3ci%BUILD_NUMBER% -f lab3\\ci\\compose.yaml run --rm -T users-tests'
            }
        }

        stage('Тесты catalog на отдельной PostgreSQL') {
            steps {
                bat 'docker compose -p lab3ci%BUILD_NUMBER% -f lab3\\ci\\compose.yaml run --rm -T catalog-tests'
            }
        }

        stage('Тесты orders на отдельной PostgreSQL') {
            steps {
                bat 'docker compose -p lab3ci%BUILD_NUMBER% -f lab3\\ci\\compose.yaml run --rm -T orders-tests'
            }
        }

        stage('Сборка Vue и Nginx') {
            steps {
                bat 'docker build -t lab3-frontend:k8s-j%BUILD_NUMBER% -f lab3\\frontend\\Dockerfile .'
            }
        }

        stage('Kubernetes: миграции и деплой') {
            steps {
                // ci_deploy.py использует существующие БД, PVC и Secret; ничего не удаляет.
                bat 'python lab3\\k8s\\ci_deploy.py --tag k8s-j%BUILD_NUMBER%'
            }
        }

        stage('Проверка состояния кластера') {
            steps {
                bat 'kubectl get deployments,replicasets,pods -n lab3'
                bat 'kubectl rollout status deployment/users -n lab3 --timeout=180s'
                bat 'kubectl rollout status deployment/catalog -n lab3 --timeout=180s'
                bat 'kubectl rollout status deployment/orders -n lab3 --timeout=180s'
                bat 'kubectl rollout status deployment/frontend -n lab3 --timeout=180s'
            }
        }
    }

    post {
        always {
            // Удаляем ТОЛЬКО тестовый Compose-проект lab3ciN. Рабочий Compose и K8s не трогаем.
            bat(returnStatus: true, script: 'docker compose -p lab3ci%BUILD_NUMBER% -f lab3\\ci\\compose.yaml down -v --remove-orphans')
        }
    }
}
